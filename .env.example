# Generate .env with npm run setup. Never commit real credentials.
COMPOSE_PROJECT_NAME=open-hrms
POSTGRES_DB=open_hrms
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
API_PORT=4000
WEB_PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# Encryption root for provider credentials; preserve this key with your backups.
APP_ENCRYPTION_KEY=
# Optional host access via compose.database.yaml; API uses postgres:5432.
POSTGRES_PORT=5434
